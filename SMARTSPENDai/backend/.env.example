# SMARTSPEND AI Backend Environment Variables

# Node Environment (development, production, staging)
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartspend?retryWrites=true&w=majority

# Firebase Admin Configuration (Required for Production Authentication)
# Provide the absolute path to your Firebase service account JSON key file
FIREBASE_SERVICE_ACCOUNT=./config/firebase-service-account.json

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend CORS URL
FRONTEND_URL=http://localhost:5173
